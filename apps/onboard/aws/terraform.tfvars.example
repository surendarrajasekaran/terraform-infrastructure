aws_account_id = "123456789012" # Replace with the expected AWS account.
cloud       = "aws"
name        = "idea-board"
environment = "test"
region      = "us-west-2"
# Replace with your actual administrator AND stable CI runner egress CIDRs.
admin_cidrs         = ["203.0.113.10/32"]
kubernetes_version  = "1.35"
deletion_protection = true

# Private API is the secure default. Replace admin_cidrs with the runner/VPN
# source visible to that endpoint. Public access is an explicit reviewed opt-in.
public_cluster_endpoint = false
flow_logs_enabled       = true
log_retention_days      = 14
database                = { storage_gb = 20, max_storage_gb = 100, backup_days = 7 }
labels                  = { owner = "platform", cost_center = "case-study" }
aws_node_pool           = { min_size = 1, desired_size = 1, max_size = 3, instance_types = ["t3.medium"] }

# Private test administration and the reviewed Argo controller image mirror.
aws_enable_ssm_access = true
aws_additional_ecr_services = ["argocd"]
# The application publisher belongs to om-idea-board, not this infrastructure repo.
# Replace the account in this ARN when onboarding another AWS account.
github_repository = "surendarrajasekaran/om-idea-board"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
github_oidc_subject_prefix = "repo:surendarrajasekaran@35868093/om-idea-board@1438722777"
